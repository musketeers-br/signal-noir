# Signal Noir runtime settings. Copy to .env (git-ignored) and fill in your own key.
# Read only when the container is created: after editing, run `docker compose down` then `up`.
# The key enters only at runtime; never put it in a build argument, an image or a commit.

# AI provider for the Agent: openai | anthropic | gemini | bedrock
SN_AI_PROVIDER=openai
SN_AI_MODEL=<model>
# Without a key the app still starts: the provider is reported unavailable and the Cases that
# need it end in ReviewRequired with that reason.
SN_AI_API_KEY=<your-key>

# The scenario Simulator served by the same instance
SN_SIM_BASE_URL=http://localhost:52773/sim/api/v1

# 1 schedules the sweeper and the Origin feed reader (every minute). Leave it unset on a dev
# database that holds test requests.
SN_BACKGROUND_TASKS=1

# Optional timings, in seconds (defaults shown). The lease must exceed partner timeout + budget.
# SN_PARTNER_TIMEOUT_SECONDS=60
# SN_INVESTIGATION_BUDGET_SECONDS=120
# SN_AI_LEASE_SECONDS=300

# Optional: directory of the built console inside the container
# SN_UI_PATH=/home/irisowner/dev/ui/build/
